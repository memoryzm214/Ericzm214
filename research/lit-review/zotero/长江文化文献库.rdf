      <dc:identifier><dcterms:URI><rdf:value>https://www.frontiersin.org/journals/psychology/articles/10.3389/fpsyg.2026.1880795/full</rdf:value></dcterms:URI></dc:identifier>
      <dc:subject>A1-3</dc:subject>
